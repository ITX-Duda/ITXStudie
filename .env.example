# ─── Backend (backend/.env) ───────────────────────────────────────────────────
# Conexão com PostgreSQL
DATABASE_URL="postgresql://itxstudie:password@localhost:5432/itxstudie_db?schema=public"

# Chave secreta para JWT (troque por algo seguro em produção)
JWT_SECRET="super-secret-key-change-me-in-production"

# Porta do servidor NestJS (padrão: 3001)
PORT=3001

# ─── Frontend (frontend/.env.local) ───────────────────────────────────────────
# URL base do backend — mude para o IP do Tailscale ou URL de produção
NEXT_PUBLIC_API_URL="http://localhost:3001"

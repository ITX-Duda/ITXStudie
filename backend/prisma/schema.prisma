// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  password      String
  name          String?
  sessions      Session[]
  categories    Category[]
  topics        Topic[]
  circles       StudyCircle[]
  circleRuns    CircleRun[]
  quarterPlans  QuarterPlan[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Category {
  id        String        @id @default(uuid())
  name      String
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  topics    Topic[]
  sessions  Session[]
  phases    CirclePhase[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Topic {
  id                 String             @id @default(uuid())
  name               String
  categoryId         String
  category           Category           @relation(fields: [categoryId], references: [id])
  userId             String
  user               User               @relation(fields: [userId], references: [id])
  sessions           Session[]
  phases             CirclePhase[]
  quarterPlanTopics  QuarterPlanTopic[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Session {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  categoryId   String?
  category     Category?  @relation(fields: [categoryId], references: [id])
  topicId      String?
  topic        Topic?     @relation(fields: [topicId], references: [id])
  circleRunId  String?
  circleRun    CircleRun? @relation(fields: [circleRunId], references: [id])
  phaseOrder   Int?       // which phase within the circle this session tracks
  startTime    DateTime   @default(now())
  endTime      DateTime?
  durationMins Int?
  status       String     @default("running") // running | stopped
  notes        String?    // free-form notes taken during/after session
  rating       String?    // productive | unproductive | null
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model QuarterPlan {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  name      String             // e.g. "Q3 2026"
  topics    QuarterPlanTopic[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model QuarterPlanTopic {
  id        String      @id @default(uuid())
  planId    String
  plan      QuarterPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic       @relation(fields: [topicId], references: [id])
  order     Int         @default(0)
  createdAt DateTime    @default(now())
}

model StudyCircle {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  name        String
  description String?
  phases      CirclePhase[]
  runs        CircleRun[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CirclePhase {
  id           String      @id @default(uuid())
  circleId     String
  circle       StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  order        Int         // 1-indexed position in the sequence
  type         String      // "study" | "break"
  durationMins Int
  label        String?     // e.g. "Focus Block", "Short Break"
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  topicId      String?
  topic        Topic?      @relation(fields: [topicId], references: [id])
}

model CircleRun {
  id                String      @id @default(uuid())
  circleId          String
  circle            StudyCircle @relation(fields: [circleId], references: [id])
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  startedAt         DateTime    @default(now())
  completedAt       DateTime?
  status            String      @default("running") // running | completed | abandoned
  currentPhaseOrder Int         @default(1)
  sessions          Session[]
}
